# Copy to .env and adjust. docker compose reads .env automatically.
# Every variable below has a working default, so `docker compose up -d` runs without a .env file.

# ---------------------------------------------------------------- PostgreSQL
# Database the service stores tenants, subscriptions, usage and invoices in.
POSTGRES_DB=subscription
POSTGRES_USER=subscription
POSTGRES_PASSWORD=subscription
# Host port mapped to the container's 5432.
POSTGRES_PORT=5432

# ---------------------------------------------------------- Application (JVM)
# Host port mapped to the service's 8080.
APP_PORT=8080
# Spring profile: `dev` uses in-memory H2, `prod` uses PostgreSQL. The container defaults to prod.
SPRING_PROFILES_ACTIVE=prod
# JDBC URL used by the `prod` profile.
DB_URL=jdbc:postgresql://postgres:5432/subscription
DB_USERNAME=subscription
DB_PASSWORD=subscription
# HikariCP maximum pool size.
DB_POOL_SIZE=10

# --------------------------------------------------------------------- Kafka
# Host port mapped to the broker's external listener.
KAFKA_PORT=9092
# Bootstrap servers the service connects to. Use `kafka:29092` from inside the compose
# network, `localhost:9092` when running the service on the host.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ------------------------------------------------------------------ Keycloak
# Host port mapped to Keycloak's 8080.
KEYCLOAK_PORT=8081
# Bootstrap admin for the Keycloak console at http://localhost:8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Issuer the resource server validates tokens against. This must match the `iss` claim in the
# token exactly, so use `http://keycloak:8080/...` from inside the network and
# `http://localhost:8081/...` when the service runs on the host.
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/saas-platform

# ------------------------------------------------------------------- Billing
# Fallback price per overage unit when a plan does not define its own rate.
BILLING_DEFAULT_OVERAGE_RATE=0.10
# ISO-4217 code stamped on generated invoices.
BILLING_CURRENCY=USD
